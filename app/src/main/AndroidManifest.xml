<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked for once after sign-in (push/NotificationPermissionPrompt.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Uploads keep running, with a notification, after the app is left (files/UploadWorker.kt).
         No storage or camera permission: the system pickers and the camera app hand files over. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Calls (call/): the microphone, and the camera for video calls, asked for on the call
         screen when a call starts or is answered. The call is one of the phone's own calls
         (Bluetooth headsets, cars, a regular call putting it on hold), runs in a foreground
         service while the screen is off or another app is in front, rings over the lock screen,
         and turns the screen off at the ear. Bluetooth: the names of headsets in the audio
         output list (Android 12+). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Without these lines the two permissions above would hide the app from devices that
         have no camera or no microphone. Calls are optional. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- The unread number on the app icon, on Honor and Huawei launchers (badge/BadgeUpdater.kt).
         Other phones ignore these; nothing is asked of the user. -->
    <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />

    <!-- Lets the login screen find a browser for the sign-in tab on Android 11+, and the
         badge code see the two launchers it can hand a number to. -->
    <queries>
        <package android:name="com.hihonor.android.launcher" />
        <package android:name="com.huawei.android.launcher" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".TalqApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TalQ">
        <!-- singleTask: a notification tap or the return from the sign-in tab lands in the
             one existing instance (onNewIntent) instead of stacking a second one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share target ("Share" in another app, then TalQ). The only exported component
             besides the launcher activity. It reads content:// items only, never file paths
             (files/ShareActivity.kt), and copies them into the cache before anything is sent. -->
        <activity
            android:name=".files.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Hands single cache files to other apps (the camera writes its photo into one; opening
             and sharing received files come next). Not exported: access is granted per URI.
             Only the cache subfolders named in res/xml/file_paths.xml can be reached. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The call screen: its own task, shown over the lock screen (only this activity, never
             the chats). Not exported: notifications and the app open it with explicit intents. -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            tools:targetApi="27" />

        <!-- Keeps a call running in the background, with its notification. -->
        <service
            android:name=".call.TalqCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <!-- Keeps the app running while a call rings (its notification is the ringing one). -->
        <service
            android:name=".call.TalqRingService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <!-- Decline and Hang up from the call notifications. -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <!-- WorkManager's foreground service, given the type Android 14+ asks for. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- UnifiedPush connector 3.x: its own manifest already merges the exported receiver
             (plus the WAKE_LOCK permission and the distributor <queries>); the app only
             declares the service that receiver hands its events to. -->
        <service
            android:name=".push.TalqPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
